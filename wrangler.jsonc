{
  // Copernix on Cloudflare (ADR 0011): static package + read-only proxy for the backend.
  // `node scripts/build-landing.mjs` writes dist/landing first.
  "name": "demo",
  "main": "deploy/cloudflare/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "API_ORIGIN": "https://copernix-api.daxrpm.dev" },
  "assets": {
    "directory": "./dist/landing",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
