{
  "name": "skyshift-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint src tests copernix vite.copernix.config.ts",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "dev:copernix": "vite -c vite.copernix.config.ts",
    "build:copernix": "tsc --noEmit && vite build -c vite.copernix.config.ts",
    "test:smoke": "node smoke.mjs",
    "test:series-smoke": "node series-smoke.mjs",
    "test:app-smoke": "node app-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.10.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "fast-check": "4.5.3",
    "openapi-typescript": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
