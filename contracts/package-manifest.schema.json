{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skyshift:contract:package-manifest:0.1-draft",
  "title": "Prepared package manifest (SkyShift contract, DRAFT 0.1)",
  "description": "Index of an offline/prepared data package for guided cases: which observations it contains, which local files exist, their checksums and where every byte came from. DRAFT: proposed in docs/specs/0001-arquitectura-observation.md section 4.5. Case content (ScientificCase), regions (Region) and measurements (AnalysisResult) are referenced by opaque IDs; their schemas belong to their owners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "package_version", "content_origin", "prepared_at",
    "prepared_with", "sources", "cases", "observations", "assets", "completeness", "acknowledgements"
  ],
  "properties": {
    "schema_version": { "const": "0.1-draft" },
    "package_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "package_version": { "description": "Monotonic package revision chosen by the preparer, e.g. 1, 2, 3.", "type": "integer", "minimum": 1 },
    "content_origin": {
      "description": "irsa_snapshot = real NASA/IRSA data captured at sources[].retrieved_at; synthetic_fixture = invented data for tests/mocks, which the UI must label as such and never present as real.",
      "enum": ["irsa_snapshot", "synthetic_fixture"]
    },
    "prepared_at": { "$ref": "urn:skyshift:contract:observation:0.1-draft#/$defs/UtcTimestamp" },
    "prepared_with": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software", "repository_commit"],
      "properties": {
        "software": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
          }
        },
        "repository_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "sources": {
      "description": "Every external query or download used to build the package.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "request", "retrieved_at", "status"],
        "properties": {
          "service": { "enum": ["irsa_sia2", "irsa_cutout", "spherex_s3", "irsa_browse", "synthetic"] },
          "request": { "type": "string", "minLength": 1 },
          "retrieved_at": { "$ref": "urn:skyshift:contract:observation:0.1-draft#/$defs/UtcTimestamp" },
          "status": { "description": "e.g. QUERY_STATUS OK / OVERFLOW, HTTP 206.", "type": "string", "minLength": 1 }
        }
      }
    },
    "cases": {
      "description": "Guided cases included. Content and review status live in ScientificCase (owner: Sebastián).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_ref", "region_ref", "observation_ids", "analysis_refs"],
        "properties": {
          "case_ref": { "$ref": "urn:skyshift:contract:observation:0.1-draft#/$defs/OpaqueId" },
          "region_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region_id", "revision"],
            "properties": {
              "region_id": { "$ref": "urn:skyshift:contract:observation:0.1-draft#/$defs/OpaqueId" },
              "revision": { "type": ["integer", "string", "null"] }
            }
          },
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "urn:skyshift:contract:observation:0.1-draft#/$defs/ObservationId" }
          },
          "analysis_refs": { "type": "array", "items": { "$ref": "urn:skyshift:contract:observation:0.1-draft#/$defs/OpaqueId" } }
        }
      }
    },
    "observations": { "type": "array", "items": { "$ref": "urn:skyshift:contract:observation:0.1-draft" } },
    "assets": {
      "description": "Every local file shipped in the package. Paths are POSIX, relative to the package root, without '..'.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "media_type", "product_id", "role"],
        "properties": {
          "path": {
            "description": "Relative POSIX path: segments separated by a single '/', no '.' or '..' segments, no leading or trailing '/'.",
            "type": "string",
            "pattern": "^(?!\\.{1,2}(/|$))(?!.*/\\.{1,2}(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string", "minLength": 1 },
          "product_id": {
            "description": "Product this file materialises. null only for case_text (explanatory text owned by ScientificCase).",
            "oneOf": [{ "$ref": "urn:skyshift:contract:observation:0.1-draft#/$defs/ProductId" }, { "type": "null" }]
          },
          "role": { "enum": ["native_cutout", "calibration_extract", "derived", "display", "case_text"] }
        },
        "if": { "properties": { "role": { "const": "case_text" } } },
        "then": { "properties": { "product_id": { "type": "null" } } },
        "else": { "properties": { "product_id": { "type": "string" } } }
      }
    },
    "completeness": {
      "description": "complete only if every asset the cases need is listed and its checksum was verified on the target device.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verified_at", "missing"],
      "properties": {
        "status": { "enum": ["complete", "incomplete", "unverified"] },
        "verified_at": { "oneOf": [{ "$ref": "urn:skyshift:contract:observation:0.1-draft#/$defs/UtcTimestamp" }, { "type": "null" }] },
        "missing": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "complete" } } }, "then": { "properties": { "missing": { "maxItems": 0 }, "verified_at": { "type": "string" } } } },
        { "if": { "properties": { "status": { "const": "incomplete" } } }, "then": { "properties": { "missing": { "minItems": 1 } } } },
        { "if": { "properties": { "status": { "const": "unverified" } } }, "then": { "properties": { "verified_at": { "type": "null" } } } }
      ]
    },
    "acknowledgements": {
      "description": "Official acknowledgement / citation pages that must be shown with SPHEREx data (IRSA SPHEREx mission page).",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^https://" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "content_origin": { "const": "irsa_snapshot" } } },
      "then": { "properties": { "observations": { "items": { "properties": { "identity_status": { "const": "resolved" } } } } } }
    },
    {
      "if": { "properties": { "content_origin": { "const": "synthetic_fixture" } } },
      "then": { "properties": { "observations": { "items": { "properties": { "observation_id": { "pattern": "^synthetic:" } } } } } }
    },
    {
      "description": "A package declared complete must contain at least one case and its observations.",
      "if": { "properties": { "completeness": { "properties": { "status": { "const": "complete" } } } } },
      "then": { "properties": { "cases": { "minItems": 1 }, "observations": { "minItems": 1 } } }
    }
  ]
}
